# Where the Medusa backend lives. The publishable key is not a secret: it scopes
# requests to one sales channel and is designed to ship in the client bundle.
# Get it by running the backend seed, which prints it, or from Settings ->
# Publishable API Keys in the Medusa admin.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9001
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# ISO-2 country used to pick the pricing region. The shop sells in Namibia.
NEXT_PUBLIC_MEDUSA_COUNTRY=na

# Demo mode. Shows invented reviews for buyer demos and, in exchange, forces the
# site to noindex and strips aggregateRating from structured data. Unset to go live.
NEXT_PUBLIC_DEMO_DATA=false
