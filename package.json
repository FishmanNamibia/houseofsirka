{
  "name": "house-of-sirka",
  "private": true,
  "version": "0.3.0",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "storefront:dev": "npm run dev --workspace @sirka/storefront",
    "backend:dev": "npm run dev --workspace @sirka/backend",
    "build": "turbo run build",
    "storefront:build": "npm run build --workspace @sirka/storefront",
    "backend:build": "npm run build --workspace @sirka/backend",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.5.5"
  }
}
