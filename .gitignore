# Dependencies — hoisted to the workspace root, but npm may still create
# per-app directories for conflicting versions.
node_modules/
.pnp
.pnp.js

# Next.js (storefront)
.next/
out/

# Medusa (backend)
.medusa/
dist/

# Turbo
.turbo/

# Build output
build/

# Environment — never commit. apps/backend/.env holds the JWT and cookie
# signing secrets and the database URL.
.env
.env.*
!.env.template
!.env.example

# Misc
.DS_Store
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
